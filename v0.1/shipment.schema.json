{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trade-agent-profile.github.io/v0.1/shipment.schema.json",
  "title": "shipment.json - common data contract v0.1 (versions 0.1.0 and 0.1.1)",
  "description": "Experimental reference specification. Not an official specification of any standards body. One shipment per JSON document. Top-level values are the reconciled (authoritative) values; documents[].fields hold what each document said and where it was found. Every item of the document's own contract_version must be present; use null where the value is unknown and null is allowed. The shape of parties, trade_terms and transport is chosen by contract_version: 0.1.1 adds parties.notify_parties, trade_terms.freight_amount, trade_terms.insurance_premium_amount, transport.vessel_name, transport.voyage_number and transport.booking_number. A 0.1.0 document stays valid as it is. Codes are checked for format only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "shipment_id",
    "direction",
    "status",
    "parties",
    "trade_terms",
    "transport",
    "lines",
    "totals",
    "documents",
    "events",
    "ext"
  ],
  "properties": {
    "contract_version": { "type": "string", "$ref": "#/$defs/version" },
    "shipment_id": { "type": "string", "$ref": "#/$defs/shipment_id" },
    "direction": { "type": "string", "enum": ["export", "import"] },
    "status": {
      "type": "string",
      "enum": ["draft", "checked", "submitted", "approved", "rejected", "cancelled"]
    },
    "parties": {},
    "trade_terms": {},
    "transport": {},
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "line_no",
          "description",
          "hs_code_jp",
          "hs_code_dest",
          "origin_country",
          "quantity",
          "quantity_unit",
          "net_weight_kg",
          "gross_weight_kg",
          "packages",
          "package_type",
          "unit_price",
          "amount",
          "container_number"
        ],
        "properties": {
          "line_no": { "type": "integer", "minimum": 1 },
          "description": { "type": "string", "minLength": 1 },
          "hs_code_jp": { "type": ["string", "null"], "$ref": "#/$defs/hs_code_jp" },
          "hs_code_dest": { "type": ["string", "null"], "$ref": "#/$defs/hs_code_dest" },
          "origin_country": { "type": ["string", "null"], "$ref": "#/$defs/country" },
          "quantity": { "type": "string", "$ref": "#/$defs/quantity" },
          "quantity_unit": { "type": "string", "$ref": "#/$defs/unit" },
          "net_weight_kg": { "type": ["string", "null"], "$ref": "#/$defs/weight" },
          "gross_weight_kg": { "type": ["string", "null"], "$ref": "#/$defs/weight" },
          "packages": { "type": ["integer", "null"], "minimum": 0 },
          "package_type": { "type": ["string", "null"], "$ref": "#/$defs/package_type" },
          "unit_price": { "type": ["string", "null"], "$ref": "#/$defs/unit_price" },
          "amount": { "type": "string", "$ref": "#/$defs/amount" },
          "container_number": { "type": ["string", "null"], "$ref": "#/$defs/container_number" }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "net_weight_kg", "gross_weight_kg", "packages"],
      "properties": {
        "amount": { "type": "string", "$ref": "#/$defs/amount" },
        "net_weight_kg": { "type": ["string", "null"], "$ref": "#/$defs/weight" },
        "gross_weight_kg": { "type": ["string", "null"], "$ref": "#/$defs/weight" },
        "packages": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["doc_type", "doc_number", "issue_date", "file", "sha256", "fields"],
        "properties": {
          "doc_type": {
            "type": "string",
            "enum": [
              "commercial_invoice",
              "packing_list",
              "bill_of_lading",
              "sea_waybill",
              "shipping_instruction",
              "booking_confirmation",
              "export_declaration",
              "export_permit",
              "certificate_of_origin",
              "insurance_certificate",
              "weight_certificate",
              "photo",
              "other"
            ]
          },
          "doc_number": { "type": ["string", "null"], "minLength": 1 },
          "issue_date": { "type": ["string", "null"], "$ref": "#/$defs/date" },
          "file": { "type": ["string", "null"], "minLength": 1 },
          "sha256": { "type": ["string", "null"], "$ref": "#/$defs/sha256" },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "page", "bbox", "extracted_by", "confidence"],
              "properties": {
                "value": { "type": ["string", "number", "boolean"] },
                "page": { "type": ["integer", "null"], "minimum": 1 },
                "bbox": {
                  "type": ["array", "null"],
                  "items": { "type": "number" },
                  "minItems": 4,
                  "maxItems": 4
                },
                "extracted_by": { "type": "string", "enum": ["human", "rule", "ai"] },
                "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
              }
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "at", "by", "note"],
        "properties": {
          "type": { "type": "string", "$ref": "#/$defs/event_type" },
          "at": { "type": "string", "$ref": "#/$defs/datetime" },
          "by": { "type": "string", "enum": ["human", "rule", "ai"] },
          "note": { "type": ["string", "null"] }
        }
      }
    },
    "ext": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_-]*$" },
      "additionalProperties": { "type": "object" }
    }
  },
  "allOf": [
    {
      "$comment": "A well-formed contract_version must be one this schema knows.",
      "if": {
        "required": ["contract_version"],
        "properties": {
          "contract_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
        }
      },
      "then": {
        "properties": { "contract_version": { "enum": ["0.1.0", "0.1.1"] } }
      }
    },
    {
      "$comment": "Shape of a 0.1.0 document. Frozen: do not change.",
      "if": {
        "required": ["contract_version"],
        "properties": { "contract_version": { "const": "0.1.0" } }
      },
      "then": {
        "properties": {
          "parties": { "type": "object", "$ref": "#/$defs/parties_0_1_0" },
          "trade_terms": { "type": "object", "$ref": "#/$defs/trade_terms_0_1_0" },
          "transport": { "type": "object", "$ref": "#/$defs/transport_0_1_0" }
        }
      }
    },
    {
      "$comment": "Shape of a 0.1.1 document: the 0.1.0 items plus six added items.",
      "if": {
        "required": ["contract_version"],
        "properties": { "contract_version": { "const": "0.1.1" } }
      },
      "then": {
        "properties": {
          "parties": { "type": "object", "$ref": "#/$defs/parties_0_1_1" },
          "trade_terms": { "type": "object", "$ref": "#/$defs/trade_terms_0_1_1" },
          "transport": { "type": "object", "$ref": "#/$defs/transport_0_1_1" }
        }
      }
    }
  ],
  "$defs": {
    "version": { "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "x-kind": "version" },
    "shipment_id": { "pattern": "^SHP-[0-9]{4}-[0-9]{4,}$", "x-kind": "shipment_id" },
    "date": { "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "x-kind": "date" },
    "datetime": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
      "x-kind": "datetime"
    },
    "country": { "pattern": "^[A-Z]{2}$", "x-kind": "country" },
    "currency": { "pattern": "^[A-Z]{3}$", "x-kind": "currency" },
    "locode": { "pattern": "^[A-Z]{2}[A-Z2-9]{3}$", "x-kind": "locode" },
    "unit": { "pattern": "^[A-Z0-9]{2,3}$", "x-kind": "unit" },
    "package_type": { "pattern": "^[A-Z0-9]{2}$", "x-kind": "package_type" },
    "iso_type": { "pattern": "^[A-Z0-9]{4}$", "x-kind": "iso_type" },
    "container_number": { "pattern": "^[A-Z]{3}[UJZ][0-9]{7}$", "x-kind": "container_number" },
    "incoterms": { "pattern": "^[A-Z]{3}$", "x-kind": "incoterms" },
    "incoterms_version": { "pattern": "^[0-9]{4}$", "x-kind": "incoterms_version" },
    "amount": { "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$", "x-kind": "amount" },
    "quantity": { "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,3})?$", "x-kind": "quantity" },
    "weight": { "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,3})?$", "x-kind": "weight" },
    "unit_price": { "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$", "x-kind": "unit_price" },
    "hs_code_jp": { "pattern": "^[0-9]{9}$", "x-kind": "hs_code_jp" },
    "hs_code_dest": { "pattern": "^[0-9]{6,13}$", "x-kind": "hs_code_dest" },
    "sha256": { "pattern": "^[0-9a-f]{64}$", "x-kind": "sha256" },
    "event_type": { "pattern": "^[a-z][a-z0-9_]*$", "x-kind": "event_type" },
    "party": {
      "additionalProperties": false,
      "required": ["name", "address", "country"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "address": { "type": ["string", "null"], "minLength": 1 },
        "country": { "type": ["string", "null"], "$ref": "#/$defs/country" }
      }
    },
    "container": {
      "additionalProperties": false,
      "required": ["number", "iso_type", "seals", "gross_weight_kg"],
      "properties": {
        "number": { "type": "string", "$ref": "#/$defs/container_number" },
        "iso_type": { "type": ["string", "null"], "$ref": "#/$defs/iso_type" },
        "seals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "gross_weight_kg": { "type": ["string", "null"], "$ref": "#/$defs/weight" }
      }
    },
    "parties_0_1_0": {
      "additionalProperties": false,
      "required": ["shipper", "exporter", "consignee"],
      "properties": {
        "shipper": { "type": "object", "$ref": "#/$defs/party" },
        "exporter": { "type": ["object", "null"], "$ref": "#/$defs/party" },
        "consignee": { "type": "object", "$ref": "#/$defs/party" }
      }
    },
    "parties_0_1_1": {
      "additionalProperties": false,
      "required": ["shipper", "exporter", "consignee", "notify_parties"],
      "properties": {
        "shipper": { "type": "object", "$ref": "#/$defs/party" },
        "exporter": { "type": ["object", "null"], "$ref": "#/$defs/party" },
        "consignee": { "type": "object", "$ref": "#/$defs/party" },
        "notify_parties": {
          "type": "array",
          "maxItems": 3,
          "items": { "type": "object", "$ref": "#/$defs/party" }
        }
      }
    },
    "trade_terms_0_1_0": {
      "additionalProperties": false,
      "required": ["incoterms", "incoterms_version", "place", "currency", "payment_terms"],
      "properties": {
        "incoterms": { "type": "string", "$ref": "#/$defs/incoterms" },
        "incoterms_version": { "type": "string", "$ref": "#/$defs/incoterms_version" },
        "place": { "type": ["string", "null"], "$ref": "#/$defs/locode" },
        "currency": { "type": "string", "$ref": "#/$defs/currency" },
        "payment_terms": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "trade_terms_0_1_1": {
      "additionalProperties": false,
      "required": [
        "incoterms",
        "incoterms_version",
        "place",
        "currency",
        "payment_terms",
        "freight_amount",
        "insurance_premium_amount"
      ],
      "properties": {
        "incoterms": { "type": "string", "$ref": "#/$defs/incoterms" },
        "incoterms_version": { "type": "string", "$ref": "#/$defs/incoterms_version" },
        "place": { "type": ["string", "null"], "$ref": "#/$defs/locode" },
        "currency": { "type": "string", "$ref": "#/$defs/currency" },
        "payment_terms": { "type": ["string", "null"], "minLength": 1 },
        "freight_amount": { "type": ["string", "null"], "$ref": "#/$defs/amount" },
        "insurance_premium_amount": { "type": ["string", "null"], "$ref": "#/$defs/amount" }
      }
    },
    "transport_0_1_0": {
      "additionalProperties": false,
      "required": ["mode", "port_of_loading", "port_of_discharge", "etd", "eta", "containers"],
      "properties": {
        "mode": { "type": "string", "enum": ["sea", "air", "road", "rail", "multimodal"] },
        "port_of_loading": { "type": "string", "$ref": "#/$defs/locode" },
        "port_of_discharge": { "type": "string", "$ref": "#/$defs/locode" },
        "etd": { "type": ["string", "null"], "$ref": "#/$defs/date" },
        "eta": { "type": ["string", "null"], "$ref": "#/$defs/date" },
        "containers": {
          "type": "array",
          "items": { "type": "object", "$ref": "#/$defs/container" }
        }
      }
    },
    "transport_0_1_1": {
      "additionalProperties": false,
      "required": [
        "mode",
        "port_of_loading",
        "port_of_discharge",
        "etd",
        "eta",
        "vessel_name",
        "voyage_number",
        "booking_number",
        "containers"
      ],
      "properties": {
        "mode": { "type": "string", "enum": ["sea", "air", "road", "rail", "multimodal"] },
        "port_of_loading": { "type": "string", "$ref": "#/$defs/locode" },
        "port_of_discharge": { "type": "string", "$ref": "#/$defs/locode" },
        "etd": { "type": ["string", "null"], "$ref": "#/$defs/date" },
        "eta": { "type": ["string", "null"], "$ref": "#/$defs/date" },
        "vessel_name": { "type": ["string", "null"], "minLength": 1 },
        "voyage_number": { "type": ["string", "null"], "minLength": 1 },
        "booking_number": { "type": ["string", "null"], "minLength": 1 },
        "containers": {
          "type": "array",
          "items": { "type": "object", "$ref": "#/$defs/container" }
        }
      }
    }
  }
}
